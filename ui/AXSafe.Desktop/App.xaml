<Application x:Class="AXSafe.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Farbtokens (Entwurfswerte nach Nutzerreferenz; Kontrast in P13 zu prüfen) -->
        <Color x:Key="BgColor">#0A1426</Color>
        <Color x:Key="NavColor">#0C1830</Color>
        <Color x:Key="PanelColor">#11203D</Color>
        <Color x:Key="PanelHiColor">#162A4E</Color>
        <Color x:Key="BorderColor">#22396A</Color>
        <Color x:Key="TextColor">#E8EEF8</Color>
        <Color x:Key="MutedColor">#94A7C6</Color>
        <Color x:Key="CyanColor">#22D3EE</Color>
        <Color x:Key="BlueColor">#3B82F6</Color>
        <Color x:Key="GreenColor">#34D399</Color>
        <Color x:Key="AmberColor">#FBBF24</Color>
        <Color x:Key="RedColor">#F87171</Color>

        <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="Nav" Color="{StaticResource NavColor}"/>
        <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelHi" Color="{StaticResource PanelHiColor}"/>
        <SolidColorBrush x:Key="Line" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
        <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}"/>
        <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}"/>
        <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}"/>
        <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}"/>
        <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}"/>

        <LinearGradientBrush x:Key="BannerAmber" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3A2A0A" Offset="0"/>
            <GradientStop Color="#162A4E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ShieldFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <!-- AXSafe Schild (eigene Vektorform) -->
        <Geometry x:Key="ShieldGeometry">M 50,2 L 92,16 C 92,58 76,84 50,98 C 24,84 8,58 8,16 Z</Geometry>
        <Geometry x:Key="CheckGeometry">M 30,52 L 45,67 L 72,38</Geometry>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- Navigation: RadioButtons, per Tastatur bedienbar -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="14,10" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHi}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource Blue}" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#24324F"/>
                                <Setter Property="Foreground" Value="#7A8AA8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource Line}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHi}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5D6D8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Application.Resources>
</Application>
