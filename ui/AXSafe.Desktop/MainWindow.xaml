<Window x:Class="AXSafe.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AXSafe – Vorversion" Width="1360" Height="860" MinWidth="980" MinHeight="640"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Linke Navigation ============ -->
        <Border Background="{StaticResource Nav}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,24,10,22">
                    <Viewbox Width="40" Height="40">
                        <Canvas Width="100" Height="100">
                            <Path Data="{StaticResource ShieldGeometry}" Fill="{StaticResource ShieldFill}"/>
                            <Path Data="{StaticResource CheckGeometry}" Stroke="White" StrokeThickness="9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AXSafe" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Vorversion 0.1" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Text="kein Echtzeitschutz" Foreground="{StaticResource Amber}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" KeyboardNavigation.TabNavigation="Once"
                            KeyboardNavigation.DirectionalNavigation="Cycle">
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True" Tag="overview" Checked="Nav_Checked" Content="Übersicht"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="scan" Checked="Nav_Checked" Content="Virenscan"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="realtime" Checked="Nav_Checked" Content="Echtzeitschutz"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="ransomware" Checked="Nav_Checked" Content="Ransomware-Schutz"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="network" Checked="Nav_Checked" Content="Firewall &amp; Netzwerk"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="web" Checked="Nav_Checked" Content="Web &amp; Phishing"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="quarantine" Checked="Nav_Checked" Content="Quarantäne"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="privacy" Checked="Nav_Checked" Content="Datenschutz"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="reports" Checked="Nav_Checked" Content="Berichte"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,18">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="settings" Checked="Nav_Checked" Content="Einstellungen"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="help" Checked="Nav_Checked" Content="Hilfe"/>
                    <Border Style="{StaticResource Card}" Margin="16,12,16,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Gesundheit" Style="{StaticResource MutedText}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse x:Name="HealthDot" Width="10" Height="10" Fill="{StaticResource Amber}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HealthText" Margin="8,0,0,0" FontSize="13" Text="Wird geprüft …"/>
                            </StackPanel>
                            <TextBlock x:Name="HealthDetail" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"
                                       Text="Dienst: noch nicht vorhanden (Phase P02)"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Inhalt ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,24,28,28">

                <!-- ===== Übersicht ===== -->
                <StackPanel x:Name="PageOverview">
                    <TextBlock Text="Übersicht" Style="{StaticResource H1}"/>
                    <TextBlock Text="Alle Werte stammen aus echten Prüfungen auf diesem Gerät. Nicht vorhandene Funktionen sind als solche markiert."
                               Style="{StaticResource MutedText}" Margin="0,4,0,18"/>

                    <!-- Schutzbanner: niemals grün ohne belegte Schutzpipeline -->
                    <Border CornerRadius="14" Padding="22" Background="{StaticResource BannerAmber}"
                            BorderBrush="{StaticResource Amber}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="64" Height="64" VerticalAlignment="Top">
                                <Canvas Width="100" Height="100">
                                    <Path Data="{StaticResource ShieldGeometry}" Fill="#33FBBF24" Stroke="{StaticResource Amber}" StrokeThickness="4"/>
                                    <TextBlock Canvas.Left="40" Canvas.Top="18" Text="!" FontSize="52" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel Grid.Column="1" Margin="18,0,12,0">
                                <TextBlock Text="SCHUTZSTATUS: EINGESCHRÄNKT" Foreground="{StaticResource Amber}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="AXSafe schützt dieses Gerät noch nicht in Echtzeit." Style="{StaticResource H2}" FontSize="20" Margin="0,4,0,6"/>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="14"
                                           Text="Diese Vorversion prüft Dateien nur, wenn du einen Scan startest. Lass deinen bisherigen Virenschutz (z. B. Microsoft Defender) unbedingt aktiv."/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Primary}" VerticalAlignment="Center"
                                    Content="Ordner prüfen" Click="GoScan_Click" AutomationProperties.Name="Zum Virenscan wechseln"/>
                        </Grid>
                    </Border>

                    <!-- Statistikzeile (nur Werte aus dem letzten echten Scan dieser Sitzung) -->
                    <UniformGrid Columns="4" Margin="0,16,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Letzter Scan" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="StatLast" Text="noch keiner" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="Geprüfte Objekte" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="StatObjects" Text="–" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="Funde" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="StatDetections" Text="–" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Nicht vollständig geprüft" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="StatIncomplete" Text="–" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*" MinWidth="260"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Engines" Style="{StaticResource H2}"/>
                                <TextBlock Text="Live abgefragt über axsafe engines" Style="{StaticResource MutedText}" Margin="0,2,0,10"/>
                                <ItemsControl x:Name="EngineList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding EngineVersion, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource MutedText}">
                                                        <Run Text="Zustand: "/>
                                                        <Run Text="{Binding Health.StateLabel, Mode=OneWay}"/>
                                                        <Run Text=" · Inhalt: "/>
                                                        <Run Text="{Binding ContentVersion, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Health.Reason, Mode=OneWay}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="EngineEmpty" Style="{StaticResource MutedText}" Visibility="Collapsed"
                                           Text="axsafe.exe wurde nicht gefunden. Lege die CLI in den Unterordner cli neben AXSafe.exe (siehe Hilfe)."/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Schutzmodule" Style="{StaticResource H2}"/>
                                <TextBlock Text="Ehrlicher Stand je Modul" Style="{StaticResource MutedText}" Margin="0,2,0,10"/>
                                <ItemsControl x:Name="ModuleList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                <Border Grid.Column="1" Style="{StaticResource Chip}" BorderBrush="{Binding Brush}">
                                                    <TextBlock Text="{Binding State}" Foreground="{Binding Brush}" FontSize="11"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ===== Virenscan ===== -->
                <StackPanel x:Name="PageScan" Visibility="Collapsed">
                    <TextBlock Text="Virenscan" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18"
                               Text="Prüft Dateien und Ordner auf Anforderung. Der Scanner liest nur: Er löscht, verschiebt und startet nichts."/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Scan Center" Style="{StaticResource H2}"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="BtnFolder" Style="{StaticResource Primary}" Content="Ordner wählen und prüfen" Click="ScanFolder_Click"/>
                                <Button x:Name="BtnFiles" Style="{StaticResource Secondary}" Content="Dateien wählen und prüfen" Click="ScanFiles_Click"/>
                                <Button x:Name="BtnCancel" Style="{StaticResource Secondary}" Content="Abbrechen" IsEnabled="False" Click="Cancel_Click"/>
                                <Button Style="{StaticResource Secondary}" Content="Schnellscan (P03)" IsEnabled="False"
                                        ToolTip="Schnellscan braucht eine geprüfte Liste typischer Ablageorte. Geplant in Phase P03."/>
                                <Button Style="{StaticResource Secondary}" Content="Offline-Scan (P09)" IsEnabled="False"
                                        ToolTip="Kein Rettungsmedium vorhanden. Geplant in Phase P09 (AXS-066)."/>
                            </WrapPanel>
                            <CheckBox x:Name="UseClamav" Content="ClamAV zusätzlich verwenden" IsChecked="True" Margin="0,14,0,0"
                                      Click="UseClamav_Click"/>
                            <TextBlock x:Name="ClamavHint" Style="{StaticResource MutedText}" Margin="22,2,0,0" Visibility="Collapsed"
                                       Text="ClamAV ist nicht installiert. Der Scan nutzt dann nur die eigenen YARA-X-Regeln; das steht auch im Bericht."/>
                            <ProgressBar x:Name="ScanProgress" Height="4" Margin="0,14,0,0" IsIndeterminate="False"
                                         Foreground="{StaticResource Cyan}" Background="{StaticResource PanelHi}" BorderThickness="0"/>
                            <TextBlock x:Name="ScanStatus" Margin="0,10,0,0" Text="Bereit. Noch kein Scan in dieser Sitzung."/>
                            <TextBlock x:Name="ScanSummary" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Ergebnisse" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                       Text="'Ohne Fund' gilt nur für die genannten Engines und Regeln. Lücken werden nie als sauber gezählt."/>
                            <ListView x:Name="ResultList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding VerdictLabel}" FontWeight="SemiBold"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Path}"/>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Berichte ===== -->
                <StackPanel x:Name="PageReports" Visibility="Collapsed">
                    <TextBlock Text="Berichte" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18"
                               Text="Jeder Scan legt einen JSON-Bericht mit Umfang, Engines, Regelständen und allen Lücken lokal ab."/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="ReportsDirText" Style="{StaticResource MutedText}"/>
                            <WrapPanel Margin="0,12,0,12">
                                <Button Style="{StaticResource Secondary}" Content="Ordner öffnen" Click="OpenReports_Click"/>
                                <Button Style="{StaticResource Secondary}" Content="Aktualisieren" Click="RefreshReports_Click"/>
                            </WrapPanel>
                            <ListBox x:Name="ReportList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Generische Infoseite für (noch) nicht vorhandene Funktionen ===== -->
                <StackPanel x:Name="PageInfo" Visibility="Collapsed">
                    <TextBlock x:Name="InfoTitle" Style="{StaticResource H1}"/>
                    <Border x:Name="InfoChip" Style="{StaticResource Chip}" Margin="0,10,0,18" BorderBrush="{StaticResource Amber}">
                        <TextBlock x:Name="InfoState" Foreground="{StaticResource Amber}" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Was ist der Stand?" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="InfoNow" Margin="0,6,0,14" FontSize="14"/>
                            <TextBlock Text="Was fehlt bis zur echten Funktion?" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="InfoNeeded" Margin="0,6,0,14" FontSize="14"/>
                            <TextBlock Text="Wichtige Grenze" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="InfoLimit" Margin="0,6,0,0" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
