<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AXSafe.Desktop</RootNamespace>
    <AssemblyName>AXSafe</AssemblyName>
    <Product>AXSafe</Product>
    <Version>0.2.0</Version>
    <Description>AXSafe Vorversion – deutsche Desktopoberfläche (kein Echtzeitschutz)</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Erlaubt das Bauen auf Linux-CI; ausgeführt wird nur auf Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Lockfile enthält den RID-Graphen für das self-contained Windows-Paket (Release prüft im Locked Mode). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AXSafe.Client\AXSafe.Client.csproj" />
  </ItemGroup>

</Project>
