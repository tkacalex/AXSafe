{
  "schema": "axsafe.rule-tests/1",
  "rule_id": "AXS-TEST-0001",
  "rule_version": "1.0.0",
  "hinweis": "EICAR wird zur Laufzeit erzeugt (generator \"eicar\"); diese Datei enthält den Teststring nicht.",
  "positive": [
    { "name": "EICAR am Dateianfang", "sample": { "generator": "eicar" } },
    { "name": "EICAR mit Zeilenende", "sample": { "generator": "eicar", "suffix_text": "\r\n" } }
  ],
  "benign": [
    { "name": "EICAR in Dokumentation zitiert (nicht am Anfang)", "sample": { "prefix_text": "Der EICAR-Teststring lautet: ", "generator": "eicar" } },
    { "name": "EICAR am Anfang einer großen Datei", "sample": { "generator": "eicar", "suffix_text": "A", "repeat_suffix": 200 } },
    { "name": "gewöhnlicher Text", "sample": { "text": "Hallo Welt" } },
    { "name": "leere Datei", "sample": { "text": "" } },
    { "name": "nur der Anfang des Teststrings", "sample": { "hex": "58354f2150254041505b345c505a58353428505e2937434329377d24" } }
  ]
}
